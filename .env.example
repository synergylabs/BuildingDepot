# BuildingDepot configuration — the only config file. Copy to `.env` and edit,
# or let `python3 deploy/install.py` provision it (with fresh secrets).
#
# These keys are the Flask config keys verbatim: `buildingdepot/bd_config.py`
# reads this file directly, so there is nothing generated from it and no name
# mapping to keep in sync. Anything not listed here has a default in that module
# (hosts default to 127.0.0.1; database names and `NAME=ds1` are structural).
#
# When a site manifest ($SITE_ENV) is present, the credentials BD registers for
# other apps (RABBITMQ_ENDUSER_*, BD_CLIENT_*) are mapped in from it — see
# MANIFEST_MAP in deploy/install.py.
#
# Generate fresh secrets manually with:
#   for v in SECRET_KEY MONGODB_PWD INFLUXDB_PWD REDIS_PWD RABBITMQ_ADMIN_PWD RABBITMQ_ENDUSER_PWD BD_CLIENT_SECRET ; do
#     printf '%s=%s\n' "$v" "$(openssl rand -hex 32)"
#   done

# --- Flask ---
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --- Mongo (runs in Docker, loopback only) ---
MONGODB_USERNAME=bdadmin
MONGODB_PWD=replace-me

# --- Influx 1.x (runs in Docker, loopback only) ---
INFLUXDB_USERNAME=bdadmin
INFLUXDB_PWD=replace-me
INFLUXDB_DB=buildingdepot

# --- Redis / Valkey (bare metal, apt) ---
REDIS_PWD=replace-me

# --- RabbitMQ (bare metal, apt) ---
RABBITMQ_ADMIN_USERNAME=bdadmin
RABBITMQ_ADMIN_PWD=replace-me
RABBITMQ_ENDUSER_USERNAME=bduser
RABBITMQ_ENDUSER_PWD=replace-me

# --- BD OAuth client registered for a co-located backend ---
# Read by deploy/bootstrap_bare.py only, never by the BD services: it upserts
# this pair as an OAuth client owned by admin@buildingdepot.org so a backend can
# authenticate before anyone visits the BD UI. Leave BD_CLIENT_ID blank to skip
# registration and mint a client with `GET /oauth/client` instead.
BD_CLIENT_ID=mites-backend
BD_CLIENT_SECRET=replace-me

# --- SMTP ---
# CentralService mails temporary passwords. `install.py --dev` runs a mailpit
# catcher on 1025 with its inbox at http://localhost:8025 — point at it with
# SMTP_PORT=1025. Defaults to localhost:25.
SMTP_HOST=localhost
SMTP_PORT=25

# --- Optional: GMAIL relay instead of plain SMTP ---
# Set EMAIL=GMAIL and fill all three credentials to send through the Gmail API
# (SMTP_HOST/SMTP_PORT are then unused). EMAIL_ID is the sending address and
# must be the Gmail account the refresh token belongs to.
# EMAIL=LOCAL
# EMAIL_ID=admin@buildingdepot.org
# CLIENT_ID=
# CLIENT_SECRET=
# REFRESH_TOKEN=

# --- Optional: Firebase push notifications instead of RabbitMQ ---
# NOTIFICATION_TYPE=FIREBASE
# FIREBASE_CREDENTIALS=
