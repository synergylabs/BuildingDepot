# BuildingDepot bare-metal env. Copy to deploy/.env and edit, or let
# deploy/install.py provision it (with fresh secrets) automatically.
#
# When a site manifest ($SITE_ENV) is present, cross-app secrets
# (RABBIT_END_USER/PWD) are mapped in from it — see MANIFEST_MAP in install.py.
#
# Generate fresh secrets manually with:
#   for v in SECRET_KEY MONGO_PWD INFLUX_PWD REDIS_PWD RABBIT_ADMIN_PWD RABBIT_END_PWD ; do
#     printf '%s=%s\n' "$v" "$(openssl rand -hex 32)"
#   done

# --- Flask ---
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --- Mongo (runs in Docker, loopback only) ---
MONGO_USER=bdadmin
MONGO_PWD=replace-me

# --- Influx 1.x (runs in Docker, loopback only) ---
INFLUX_USER=bdadmin
INFLUX_PWD=replace-me
INFLUX_DB=buildingdepot

# --- Redis / Valkey (bare metal, apt) ---
REDIS_PWD=replace-me

# --- RabbitMQ (bare metal, apt) ---
RABBIT_ADMIN_USER=bdadmin
RABBIT_ADMIN_PWD=replace-me
RABBIT_END_USER=bduser
RABBIT_END_PWD=replace-me

# --- SMTP (dev) ---
# Point CentralService at the mailpit catcher. Defaults to localhost:25 if unset.
SMTP_HOST=localhost
SMTP_PORT=25
