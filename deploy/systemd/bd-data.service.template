[Unit]
Description=BuildingDepot Data Service (gunicorn on 127.0.0.1:8082)
Documentation=file://{{ WORKING_DIRECTORY }}/README.md
After=bd-central.service
BindsTo=bd-central.service

[Service]
Type=simple
WorkingDirectory={{ WORKING_DIRECTORY }}/buildingdepot
Environment="PYTHONUNBUFFERED=TRUE"
Environment="BD_SETTINGS={{ WORKING_DIRECTORY }}/configs/bd_settings.cfg"
ExecStart={{ UV_BIN }} run gunicorn -w 4 --timeout 120 -b 127.0.0.1:8082 --access-logfile - DataService:app
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
