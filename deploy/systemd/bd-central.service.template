[Unit]
Description=BuildingDepot Central Service (gunicorn on 127.0.0.1:8081)
Documentation=file://{{ WORKING_DIRECTORY }}/README.md
After=bd-replica.service
BindsTo=bd-replica.service

[Service]
Type=simple
WorkingDirectory={{ WORKING_DIRECTORY }}/buildingdepot
Environment="PYTHONUNBUFFERED=TRUE"
ExecStart={{ UV_BIN }} run gunicorn -w 4 -b 127.0.0.1:8081 --access-logfile - CentralService:app
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
